# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=askyourdocs
# host "db" je ime servisa u compose.yml
DATABASE_URL=postgresql://postgres:postgres@db:5432/askyourdocs

# --- Embeddings (OpenAI) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- LLM (Ollama na Windows hostu) ---
# zahteva OLLAMA_HOST=0.0.0.0 na hostu, inace kontejner ne vidi Ollamu
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- Retrieval ---
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
